<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Template</title>
    <link rel="stylesheet" href="/template/style.css" />
    <link rel="stylesheet" href="/template/assets/fonts/font.css" />
    <script
      src="https://cdn.jsdelivr.net/npm/qrcode@1.4.4/build/qrcode.min.js"
  ></script>
  </head>
  <body>
    <div class="body">
      <img
        id="bg"
        src={{pnlBg}}
        class="background-image"
        alt="background-image"
      />
      <main class="pnl-main font-outfit">
        <div class="main-container">
          <section class="main-section section-left">
            <div id="percentage-container" class="{{percentageClass}}">
              <img
                id="icon"
                src={{gainLossIcon}}
                {{! src="/template/assets/icon-profit.svg" }}
                alt="profit icon"
                class="profit-icon"
              />
              <span id="percentage24h" class="{{percentageTextClass}}">
                {{percentage24h}}
              </span>
            </div>
            <div class="token-info">
              <div class="{{imageBg}}">
                <img
                  id="gradient"
                  src="/template/assets/bg-overlay-logo.svg"
                  alt="gradient logo"
                  class={{gradientLogo}}
                />
                <img src={{image}} alt="token image" class="token-image" />
              </div>
              <span class="token-name">{{symbol}}</span>
            </div>
            <div id="newHolding" class="daily-profit">
              {{#if showUSD}}
                {{profitD}}
              {{else}}
                <div style="display: flex;">
                  {{profit}}
                  <img
                    src="/template/assets/sol-white.svg"
                    alt="sol icon"
                    style="width: 30px; height:auto; margin-left:10px; margin-top: 10px"
                    {{!-- class="summary-icon" --}}
                  />
                </div>
              {{/if}}
            </div>
          </section>
          <section class="main-section section-right">
            <div class="section-right-header">
              <div style="color:#9191A4">{{leftHeader}}</div>
              <div>{{rightHeader}}</div>
            </div>
            <div class="right-content">
              <ul>
                <li class="right-list">
                  <div class="summary-item summary-bought">
                    <img
                      src="/template/assets/icon-bought.svg"
                      alt="bought icon"
                      class="summary-icon"
                    />
                    <span> Bought </span>
                  </div>
                  <div id="investedValue">
                    {{#if showUSD}}
                      {{investedD}}
                    {{else}}
                      {{invested}}
                    {{/if}}
                  </div>
                </li>
                <li class="right-list">
                  <div class="summary-item summary-holding">
                    <img
                      src="/template/assets/icon-holding.svg"
                      alt="holding icon"
                      class="summary-icon"
                    />
                    <span> Holding </span>
                  </div>
                  <div id="holdingValue">
                    {{#if showUSD}}
                      {{holdingD}}
                    {{else}}
                      {{holding}}
                    {{/if}}
                  </div>
                </li>
                <li class="right-list">
                  <div class="summary-item summary-sold">
                    <img
                      src="/template/assets/icon-sold.svg"
                      alt="sold icon"
                      class="summary-icon"
                    />
                    <span> Sold </span>
                  </div>
                  <div id="soldValue">
                    {{#if showUSD}}
                      {{soldD}}
                    {{else}}
                      {{sold}}
                    {{/if}}
                  </div>
                </li>
              </ul>
              <div class="total-profit-container">
                <div id="summary-total" class="{{summaryTotalClass}}">
                  <img
                    src="/template/assets/dots.svg"
                    alt="dots"
                    class="bg-dots"
                  />
                  <div class="total-profit-text">
                    <div id="profitD">{{profitD}} {{profitOrLoss}}</div>
                    <div id="profit">{{profitSol}}</div>
                  </div>
                </div>
                <img
                  id="gradient"
                  src={{gainLossGradient}}
                  alt="gradient profit"
                  class="gradient-profit"
                />
                <img
                  src="/template/assets/loss-grad.svg"
                  alt="gradient loss"
                  class={{lossGradOverlayClass}}
                  />
              </div>
            </div>
          </section>
        </div>
      </main>

      <footer class={{footerHeaderClass}}>
        {{!-- <section class="referral-container">
          <span class="referral-text">Referral Code :</span>
          <span id="referral-code" class="referral-code">
            {{referralCode}}</span>
          <img
            src="/template/assets/icon-sparkle.svg"
            alt="sparkle icon"
            class="sparkle-icon"
          />
        </section> --}}

        <section class="nova-socmed">
          <div>The All in One Trading Platform</div>
          <div class="nova-socmed-content">
            <p class="nova-socmed-item">
              <img
                src="/template/assets/icon-x.svg"
                alt="X icon"
                class="socmed-icon"
                style="margin-top: 2px;"
              />
              <span>@tradeonnova</span>
            </p>
            <div class="separator" style="margin-top: 2px;"></div>
            <p class="nova-socmed-item">
              <img
                src="/template/assets/icon-web.svg"
                alt="Web icon"
                class="socmed-icon"
                style="margin-top: 2px;"
              />
              <span> nova.trade </span>
            </p>
          </div>
        </section>
      </footer>
    </div>

  </body>
